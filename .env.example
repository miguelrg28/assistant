# Neon pooled connection string (Vercel → Storage → Neon, or neon.tech)
DATABASE_URL=postgres://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# Public origin of the deployment, no trailing slash
BASE_URL=https://your-project.vercel.app
# openssl rand -base64 48
BETTER_AUTH_SECRET=
# The only account allowed to sign in
OWNER_EMAIL=you@example.com
# Meta app → App settings → Basic → App secret
META_APP_SECRET=
# Any random string; paste the same value into Meta's webhook config
META_VERIFY_TOKEN=
# openssl rand -hex 32 (Vercel sends it to the cron route)
CRON_SECRET=

# --- Linking the number from /whatsapp (Embedded Signup). Optional. ---
# Meta app → App settings → Basic → App ID
META_APP_ID=
# WhatsApp → Embedded Signup → Configurations → Configuration ID
META_CONFIG_ID=
# openssl rand -base64 32 (encrypts the linked access token in the database)
WHATSAPP_TOKEN_KEY=
# META_GRAPH_VERSION=v23.0
